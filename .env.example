# Application
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000

# Better Auth
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Optional alias if AUTH_SECRET is unset
# BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Discord OAuth (optional if you only use email/password)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
DISCORD_BOT_TOKEN=
OWNER_DISCORD_ID=

# MongoDB Atlas (or any hosted MongoDB)
# Example: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/vtc-timetable?retryWrites=true&w=majority
MONGODB_URI=

# Redis (optional cache; the app fails open to MongoDB if Redis is unset or down)
# Avoid @ : / in REDIS_PASSWORD when embedding it in REDIS_URL.
REDIS_URL=
REDIS_PASSWORD=

# Discord user id that can call e-card playground routes (photo stripped).
# OWNER_DISCORD_ID=

# Optional cache TTL overrides in seconds
# CACHE_TTL_TIMETABLE_SECONDS=300
# CACHE_TTL_COURSES_SECONDS=300
# CACHE_TTL_ATTENDANCE_SECONDS=60
# CACHE_TTL_MOODLE_SECONDS=300
# CACHE_TTL_PRINT_QUOTA_SECONDS=120
# CACHE_TTL_PROGRAMME_SECONDS=3600
# CACHE_TTL_COURSE_HOURS_SECONDS=60
